{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": ["npx", "-y", "@browsermcp/mcp@latest"],
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "@bitbonsai/mcpvault", "/home/pepegov/Nextcloud/PepegovDB"],
      "enabled": true
    },
    "dotnet": {
      "type": "local",
      "command": ["npx","-y","@modelcontextprotocol/server-dotnet"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "figma": {
      "type": "local",
      "command": [
        "bunx",
        "figma-mcp-server"
      ]
    },
    "avalonia": {
      "type": "remote",
      "url": "https://docs-mcp.avaloniaui.net/mcp"
    },
    "rider": {
      "type": "remote",
      "url": "http://127.0.0.1:64482/stream"
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      }
    }
  }
}